# Conventional Commits rules for both halves of the release process: which
# messages are valid (`convco check`) and what version they earn
# (`convco version --bump`). Spelling the table out here rather than relying on
# convco's defaults, which leave `perf` release-neutral and reject `revert:`
# outright.
#
# `increment` is the bump the type earns on its own; a `!` marker or a
# `BREAKING CHANGE:` footer overrides it with a major bump. Types set to None
# publish nothing -- a README typo should not ship a build to the store.
types:
  - type: feat
    increment: Minor
    section: Features
    hidden: false
  - type: fix
    increment: Patch
    section: Fixes
    hidden: false
  - type: perf
    increment: Patch
    section: Performance
    hidden: false
  - type: revert
    increment: Patch
    section: Reverts
    hidden: false
  - type: build
    increment: None
    section: Other
    hidden: true
  - type: chore
    increment: None
    section: Other
    hidden: true
  - type: ci
    increment: None
    section: Other
    hidden: true
  - type: docs
    increment: None
    section: Documentation
    hidden: true
  - type: refactor
    increment: None
    section: Other
    hidden: true
  - type: style
    increment: None
    section: Other
    hidden: true
  - type: test
    increment: None
    section: Other
    hidden: true
